generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// Prisma 7: URL koneksi tidak ditulis di sini, tetapi di prisma.config.ts (CLI)
// dan di adapter Neon (aplikasi)
datasource db {
  provider = "postgresql"
}

model Product {
  id        Int      @id @default(autoincrement())
  name      String
  category  String
  price     Int
  stock     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}
