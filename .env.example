# Salin file ini menjadi .env lalu isi dengan connection string dari Neon Console
# (Dashboard > Connect). Jangan kumpulkan / commit file .env.

# Pooled connection (hostname mengandung "-pooler") - dipakai aplikasi
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct connection (tanpa "-pooler") - dipakai Prisma CLI (migrate, studio)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

PORT=3000
